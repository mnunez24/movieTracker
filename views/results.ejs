<!DOCTYPE html>
<html>
<head>
    <title>Movie Results</title>
    <link rel="stylesheet" href="/style.css">
    <link href="https://fonts.googleapis.com/css2?family=Roboto&display=swap" rel="stylesheet">
</head>
<nav>
    <a href="/">Search</a>
    <a href="/watchlist">Watchlist</a>
</nav>
<body>
    <h1>Movie Result</h1>

    <% if (movie.Response === "False") { %>
        <p>Movie not found.</p>
    <% } else { %>
        <h2><%= movie.Title %> (<%= movie.Year %>)</h2>
        <img src="<%= movie.Poster %>" alt="Movie poster" width="200">
        <p><strong>Rating:</strong> <%= movie.imdbRating %></p>
        <p><strong>Plot:</strong> <%= movie.Plot %></p>
    <% } %>
    <form action="/movies/save" method="POST">
        <input type="hidden" name="title" value="<%= movie.Title %>">
        <input type="hidden" name="year" value="<%= movie.Year %>">
        <input type="hidden" name="imdbID" value="<%= movie.imdbID %>">
        <input type="hidden" name="poster" value="<%= movie.Poster %>">
        <input type="hidden" name="plot" value="<%= movie.Plot %>">
        <input type="hidden" name="rating" value="<%= movie.imdbRating %>">
        
        <button type="submit">Save to Watchlist</button>
    </form>

    <a href="/">Search again</a>
</body>

</html>